/**
 * user-test-report — turns the anonymous, opt-in journey quiz results into
 * docs/USER_TEST.md: did understanding improve between the questions asked
 * before the journey and the same questions after it?
 *
 *   npx tsx scripts/eval/user-test-report.mts [--since 2026-10-06] [--exclude 12,15]
 *
 * Reads quiz_results with the service role (admin-only table; no personal data
 * is stored there: journey, language, self-declared familiarity, two scores,
 * stops completed, two 1–5 ratings). --exclude drops rows by id (e.g. test
 * submissions the tester reported).
 */
import { writeFile, mkdir } from "node:fs/promises";
import dotenv from "dotenv";
import { createClient } from "@supabase/supabase-js";

dotenv.config({ path: ".env.local", quiet: true });

const arg = (name: string, fallback: string) => {
  const i = process.argv.indexOf(`--${name}`);
  return i > 0 && process.argv[i + 1] ? process.argv[i + 1] : fallback;
};

type Row = {
  id: number;
  created_at: string;
  journey_slug: string;
  lang: string | null;
  familiarity: string | null;
  pre_score: number | null;
  post_score: number | null;
  total: number | null;
  completed_stops: number | null;
  total_stops: number | null;
  rating_clarity: number | null;
  rating_flow: number | null;
};

const mean = (xs: number[]) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : NaN);
const sd = (xs: number[]) => {
  if (xs.length < 2) return NaN;
  const m = mean(xs);
  return Math.sqrt(xs.reduce((a, x) => a + (x - m) ** 2, 0) / (xs.length - 1));
};
const f1 = (x: number) => (Number.isFinite(x) ? x.toFixed(1) : "—");
const p0 = (x: number) => (Number.isFinite(x) ? `${Math.round(x * 100)}%` : "—");

async function main() {
  const since = arg("since", "2026-10-04");
  const exclude = new Set(arg("exclude", "").split(",").filter(Boolean).map(Number));
  const db = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!);
  const { data, error } = await db.from("quiz_results").select("*").gte("created_at", since).order("created_at");
  if (error) throw error;
  const rows = ((data ?? []) as Row[]).filter((r) => !exclude.has(r.id));
  // Only complete before/after pairs measure learning.
  const paired = rows.filter((r) => r.pre_score != null && r.post_score != null && r.total && r.total > 0);
  const pre = paired.map((r) => r.pre_score! / r.total!);
  const post = paired.map((r) => r.post_score! / r.total!);
  const gain = paired.map((r, i) => post[i] - pre[i]);
  const improved = gain.filter((g) => g > 0).length;
  const same = gain.filter((g) => g === 0).length;
  const worse = gain.filter((g) => g < 0).length;
  // Normalised gain per person, (post − pre) / (1 − pre), for those not already at 100%.
  const norm = paired.filter((_, i) => pre[i] < 1).map((r) => (r.post_score! - r.pre_score!) / (r.total! - r.pre_score!));
  const completion = rows.filter((r) => r.total_stops).map((r) => (r.completed_stops ?? 0) / r.total_stops!);
  const clarity = rows.flatMap((r) => (r.rating_clarity ? [r.rating_clarity] : []));
  const flow = rows.flatMap((r) => (r.rating_flow ? [r.rating_flow] : []));
  const by = (key: (r: Row) => string) => {
    const groups = new Map<string, Row[]>();
    for (const r of paired) groups.set(key(r), [...(groups.get(key(r)) ?? []), r]);
    return [...groups.entries()].map(([k, rs]) => {
      const g = rs.map((r) => (r.post_score! - r.pre_score!) / r.total!);
      return `| ${k} | ${rs.length} | ${p0(mean(rs.map((r) => r.pre_score! / r.total!)))} | ${p0(mean(rs.map((r) => r.post_score! / r.total!)))} | ${g.length ? `${mean(g) >= 0 ? "+" : ""}${Math.round(mean(g) * 100)} pts` : "—"} |`;
    });
  };

  const md = [
    "# User test — does a journey improve understanding?",
    "",
    `Data: anonymous, opt-in results from the knowledge journeys (table \`quiz_results\`), submitted since ${since}. Each visitor answers the same ${paired[0]?.total ?? 3} questions before and after the journey; nothing personal is stored (no name, contact, location or religion — only a self-declared familiarity with the topic). Generated by \`npx tsx scripts/eval/user-test-report.mts\`.`,
    "",
    `**Participants with before/after scores: ${paired.length}** (all submissions: ${rows.length}).`,
    "",
    "| Measure | Result |",
    "|---|---|",
    `| Mean score before the journey | ${p0(mean(pre))} |`,
    `| Mean score after the journey | ${p0(mean(post))} |`,
    `| Mean gain | ${Number.isFinite(mean(gain)) ? `${mean(gain) >= 0 ? "+" : ""}${Math.round(mean(gain) * 100)} percentage points` : "—"} (SD ${f1(sd(gain.map((g) => g * 100)))} pts) |`,
    `| Improved / same / lower | ${improved} / ${same} / ${worse} |`,
    `| Mean normalised gain (post − pre) / (max − pre) | ${p0(mean(norm))} (n = ${norm.length}) |`,
    `| Stops completed (share of the journey) | ${p0(mean(completion))} |`,
    `| "Was the story clear?" (1–5) | ${f1(mean(clarity))} (n = ${clarity.length}) |`,
    `| "Was moving between stops smooth?" (1–5) | ${f1(mean(flow))} (n = ${flow.length}) |`,
    "",
    "## By self-declared familiarity",
    "",
    "| Familiarity | n | Before | After | Gain |",
    "|---|---|---|---|---|",
    ...by((r) => r.familiarity ?? "not given"),
    "",
    "## By language",
    "",
    "| Language | n | Before | After | Gain |",
    "|---|---|---|---|---|",
    ...by((r) => r.lang ?? "—"),
    "",
    "## Limits — read before quoting these numbers",
    "",
    `- Small sample (n = ${paired.length}), recruited from the team's personal network and mostly taking the journey remotely rather than on site; not a random sample of Madinah visitors.`,
    "- Three multiple-choice questions per journey: a coarse measure of recall of the journey's key facts, not of deeper understanding.",
    "- The same questions are asked before and after, and answers are shown after the post-quiz, so part of the gain may come from re-reading the questions (a testing effect).",
    "- Participation is voluntary: people who finish and choose to submit may differ from those who don't.",
    "",
  ].join("\n");
  await mkdir("docs", { recursive: true });
  await writeFile("docs/USER_TEST.md", md, "utf8");
  console.log(`paired ${paired.length}/${rows.length}; gain ${f1(mean(gain) * 100)} pts → docs/USER_TEST.md`);
}
main();
