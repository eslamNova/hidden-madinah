# Supabase project URL and publishable (anon) key - safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_... or legacy service_role JWT) from
# Dashboard > Project Settings > API keys. Used ONLY by scripts/ (owner creation,
# seeding, media import). Keep out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for POST /api/revalidate (used by scripts/import-media.ts).
REVALIDATE_SECRET=
# Public origin of the deployed site (used for metadata/OG URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# GA4 measurement ID (G-XXXXXXXXXX). Set on the Vercel PRODUCTION environment
# only — leaving it unset locally and in previews keeps the tag and the consent
# notice off, so dev traffic never lands in the numbers we show partners.
NEXT_PUBLIC_GA_ID=
# Google Gemini (AI guide, planner, content scripts). Server-side only — never
# prefix with NEXT_PUBLIC_. Set on Vercel Production + Preview.
GEMINI_API_KEY=
# Model names; pick from `npx tsx scripts/gemini-models.ts`.
# FAST = visitor-facing chat/parsing, SMART = offline extraction/translation.
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=
